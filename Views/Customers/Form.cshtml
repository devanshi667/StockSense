@model CustomerFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit customer" : "Add customer";
    var formAction = Model.IsEdit ? Url.Action("Edit", "Customers", new { id = Model.Id }) : Url.Action("Create", "Customers");
    var cancelUrl = Model.IsEdit ? Url.Action("Ledger", "Customers", new { id = Model.Id }) : Url.Action("Index", "Customers");
}

<div class="page-head">
    <div>
        <a href="@cancelUrl" class="back-link"><i class="bi bi-arrow-left"></i> Back</a>
        <h1 class="page-title mt-1">@(Model.IsEdit ? "Edit customer" : "Add customer")</h1>
    </div>
</div>

<form action="@formAction" method="post" class="card-soft form-card narrow" data-once novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-12">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="100" autofocus />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Mobile" class="form-label"></label>
            <input asp-for="Mobile" class="form-control" maxlength="10" inputmode="numeric" placeholder="10 digits" />
            <span asp-validation-for="Mobile" class="field-error"></span>
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" maxlength="250" />
            <span asp-validation-for="Address" class="field-error"></span>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(Model.IsEdit ? "Save changes" : "Add customer")</button>
        <a href="@cancelUrl" class="btn btn-light">Cancel</a>
    </div>
</form>
