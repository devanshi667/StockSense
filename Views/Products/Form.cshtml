@model ProductFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit product" : "Add product";
    var formAction = Model.IsEdit ? Url.Action("Edit", "Products", new { id = Model.Id }) : Url.Action("Create", "Products");
    var cancelUrl = Model.IsEdit ? Url.Action("Details", "Products", new { id = Model.Id }) : Url.Action("Index", "Products");
    var units = Lookups.CommonUnits.ToList();
    if (!string.IsNullOrWhiteSpace(Model.Unit) && !units.Contains(Model.Unit))
    {
        units.Add(Model.Unit);
    }
}

<div class="page-head">
    <div>
        <h1 class="page-title">@(Model.IsEdit ? "Edit product" : "Add product")</h1>
        <p class="page-sub">@(Model.IsEdit ? "Update prices, minimum stock or expiry. Stock changes through purchases and sales." : "Enter the product details. Opening stock can be added now or later through a purchase.")</p>
    </div>
    <div class="page-actions">
        <a href="@cancelUrl" class="btn btn-outline-secondary">Cancel</a>
    </div>
</div>

@if (!Model.Categories.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        You need at least one category before adding a product.
        <a asp-controller="Categories" asp-action="Index" class="alert-link">Create a category</a>.
    </div>
}

<form action="@formAction" method="post" class="card-soft form-card" data-once novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3">
        <div class="col-12 col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="150" autofocus />
            <span asp-validation-for="Name" class="field-error"></span>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="Sku" class="form-label"></label>
            <input asp-for="Sku" class="form-control text-uppercase" maxlength="50" />
            <span asp-validation-for="Sku" class="field-error"></span>
            <div class="form-text">Must be unique, e.g. DAI-001</div>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                <option value="">Select a category</option>
            </select>
            <span asp-validation-for="CategoryId" class="field-error"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="Unit" class="form-label"></label>
            <select asp-for="Unit" class="form-select">
                @foreach (var unit in units)
                {
                    <option value="@unit" selected="@(Model.Unit == unit)">@unit</option>
                }
            </select>
            <span asp-validation-for="Unit" class="field-error"></span>
        </div>

        <div class="col-12 col-md-6">
            <label asp-for="PurchaseCost" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">&#8377;</span>
                <input asp-for="PurchaseCost" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
            </div>
            <span asp-validation-for="PurchaseCost" class="field-error"></span>
        </div>
        <div class="col-12 col-md-6">
            <label asp-for="SellingPrice" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text">&#8377;</span>
                <input asp-for="SellingPrice" type="number" step="0.01" min="0.01" class="form-control" inputmode="decimal" />
            </div>
            <span asp-validation-for="SellingPrice" class="field-error"></span>
        </div>

        @if (Model.IsEdit)
        {
            <div class="col-12 col-md-4">
                <label class="form-label">Current stock</label>
                <div class="form-control-plaintext fw-semibold">@Fmt.Qty(Model.DisplayStock) @Model.Unit</div>
                <div class="form-text">Changes with purchases and sales. Use "Correct stock" on the details page after a stock-take.</div>
            </div>
        }
        else
        {
            <div class="col-12 col-md-4">
                <label asp-for="CurrentStock" class="form-label"></label>
                <input asp-for="CurrentStock" type="number" step="any" min="0" class="form-control" inputmode="decimal" />
                <span asp-validation-for="CurrentStock" class="field-error"></span>
            </div>
        }

        <div class="col-12 col-md-4">
            <label asp-for="MinStockLevel" class="form-label"></label>
            <input asp-for="MinStockLevel" type="number" step="any" min="0" class="form-control" inputmode="decimal" />
            <span asp-validation-for="MinStockLevel" class="field-error"></span>
            <div class="form-text">At or below this the product is "low stock".</div>
        </div>
        <div class="col-12 col-md-4">
            <label asp-for="ExpiryDate" class="form-label"></label>
            <input asp-for="ExpiryDate" type="date" class="form-control" />
            <span asp-validation-for="ExpiryDate" class="field-error"></span>
            <div class="form-text">Leave empty for non-perishable items.</div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>@(Model.IsEdit ? "Save changes" : "Add product")</button>
        <a href="@cancelUrl" class="btn btn-light">Cancel</a>
    </div>
</form>
