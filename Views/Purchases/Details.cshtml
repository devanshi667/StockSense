@model Purchase
@{
    ViewData["Title"] = Model.PurchaseNumber;
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="back-link"><i class="bi bi-arrow-left"></i> Purchases</a>
        <h1 class="page-title mt-1">
            @Model.PurchaseNumber
            @if (Model.IsDemo)
            {
                <span class="badge-soft soft-muted align-middle ms-1" title="Created by the demo data loader">Demo</span>
            }
        </h1>
        <p class="page-sub">
            <span class="chip"><i class="bi bi-calendar3"></i> @Fmt.Date(Model.PurchaseDate)</span>
            <span class="chip"><i class="bi bi-shop"></i> <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@(Model.Supplier?.Name)</a></span>
        </p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-outline-secondary" data-print><i class="bi bi-printer me-1"></i>Print</button>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New purchase</a>
    </div>
</div>

<div class="card-soft">
    <div class="table-responsive">
        <table class="table table-modern align-middle mb-0">
            <thead><tr><th>Product</th><th class="text-end">Quantity</th><th class="text-end">Unit cost</th><th>Batch expiry</th><th class="text-end">Line total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="row-title">@(item.Product?.Name ?? ("Product #" + item.ProductId))</a>
                            <div class="row-sub">@(item.Product?.Sku)</div>
                        </td>
                        <td class="text-end text-nowrap">@Fmt.Qty(item.Quantity) @(item.Product?.Unit)</td>
                        <td class="text-end text-nowrap">@Fmt.Money(item.UnitCost)</td>
                        <td class="text-nowrap">@(item.ExpiryDate.HasValue ? Fmt.Date(item.ExpiryDate.Value) : "—")</td>
                        <td class="text-end text-nowrap">@Fmt.Money(item.LineTotal)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="total-row"><td colspan="4" class="text-end">Purchase total</td><td class="text-end text-nowrap">@Fmt.Money(Model.TotalAmount)</td></tr>
            </tfoot>
        </table>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="mt-3 text-muted"><i class="bi bi-sticky me-1"></i>@Model.Notes</div>
    }
    <div class="mt-3 text-muted small">Recorded @Fmt.Stamp(Model.CreatedAt). Stock was increased when this purchase was saved.</div>
</div>
